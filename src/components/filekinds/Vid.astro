---
/**
 * Video filekind view, ported from upstream pages/filekinds/vid.php.
 *
 * Same correction as Snd.astro: the QuickTime <EMBED> the port carried over
 * plays nothing in any current browser, and Safari on iPadOS never supported
 * plugins at all. A real <video> element replaces it, so this no longer diffs
 * byte for byte against the PHP original.
 *
 * Wave C1 component.
 */
import HideableDownloadBox from "./HideableDownloadBox.astro";
import { defaultOptions } from "../../lib/site.ts";
import type { FileViewData } from "../../lib/fileHelpers.ts";

interface Props {
  file: FileViewData;
}

const f = Astro.props.file;

// autoplay arrives from the file record as a string, empty when unset.
const shouldAutoplay = f.autoplay === "true" || f.autoplay === "1";
---

<div>
  <video
    src={f.url}
    controls
    playsinline
    preload="metadata"
    width={f.width || undefined}
    height={f.height || undefined}
    autoplay={shouldAutoplay || undefined}
    muted={shouldAutoplay || undefined}
    aria-label={`Video: ${f.displayName}`}></video>
</div>

{defaultOptions.display_info ? <HideableDownloadBox file={f} /> : null}
