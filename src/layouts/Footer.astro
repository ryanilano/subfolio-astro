---
/**
 * Footer — ported from upstream layouts/footer.inc.php.
 *
 * Phase 2 (static): no auth state. Updated-since links are rendered as spans
 * (no active filter state without server-side cookies). Search box is
 * admin-only; omitted until Phase 4.
 */
import { siteConfig } from "../lib/site.ts";
import { t } from "../lib/i18n.ts";

interface Props {
  displayCopyright?: boolean;
  displayUpdatedSince?: boolean;
  copyright?: string;
}

const {
  displayCopyright = true,
  displayUpdatedSince = true,
  copyright: copy = siteConfig.site_copyright || "",
} = Astro.props;

// Optional credit line (settings.yml `site_footer_credit`). Trusted HTML: it is
// the site author's own config file, same trust model as text embeds.
const credit = siteConfig.site_footer_credit || "";
---

<footer class="footer" id="footer">
  <div class="footer__copyright">
    {displayCopyright && copy && <span class="copyright__text">{copy}</span>}
    {credit && <span class="footer__credit" set:html={credit} />}
  </div>

  {
    displayUpdatedSince && (
      <div class="footer__updatedsince">
        <span>{t("updated_since")}</span>
        <span class="faded">{t("last_week")}</span>
        <span class="updatedsince__sep">&#8226;</span>
        <span class="faded">{t("last_month")}</span>
        <span class="updatedsince__sep">&#8226;</span>
        <span class="faded">{t("my_last_visit")}</span>
      </div>
    )
  }
</footer>

<style>
  /* The credit sits inside .footer__copyright, so it runs on from the
     copyright on the same row and wraps like ordinary text when narrow.
     The theme makes footer spans and links 70px inline-blocks with side
     padding; inside running text they must be plain inline elements. */
  .footer__credit,
  .footer__credit :global(span),
  .footer__credit :global(a) {
    display: inline;
    height: auto;
    padding: 0;
  }
  .footer__credit :global(a) {
    color: inherit;
    text-decoration: underline;
  }
  .footer__credit :global(.footer__sep) {
    margin-right: 0.35em;
  }
  /* With the copyright hidden (display_copyright: false) the credit comes
     first in the row, so a leading separator in site_footer_credit would
     dangle. Hide it; configs keep their separator markup unchanged. */
  .footer__credit:first-child :global(.footer__sep:first-child) {
    display: none;
  }
</style>
